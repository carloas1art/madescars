<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--CONFIGURACIÓN DEL DOCUMENTO POR DEFECTO -->
    <defaultDocument enabled="true">
      <files>
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--REESCRITURA DE URLs PARA LARAVEL (NUEVO) -->
    <rewrite>
      <rules>
        <rule name="Laravel Routes" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!--MANEJO DE ERRORES PERSONALIZADOS -->
    <httpErrors>
      <remove statusCode="400" />
      <error statusCode="400" path="D:\Inetpub\vhosts\madecars.com\error_docs\bad_request.html" />
      <remove statusCode="401" />
      <error statusCode="401" path="D:\Inetpub\vhosts\madecars.com\error_docs\unauthorized.html" />
      <remove statusCode="403" />
      <error statusCode="403" path="D:\Inetpub\vhosts\madecars.com\error_docs\forbidden.html" />
      <remove statusCode="404" />
      <error statusCode="404" path="D:\Inetpub\vhosts\madecars.com\error_docs\not_found.html" />
      <remove statusCode="405" />
      <error statusCode="405" path="D:\Inetpub\vhosts\madecars.com\error_docs\method_not_allowed.html" />
      <remove statusCode="406" />
      <error statusCode="406" path="D:\Inetpub\vhosts\madecars.com\error_docs\not_acceptable.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="D:\Inetpub\vhosts\madecars.com\error_docs\proxy_authentication_required.html" />
      <remove statusCode="412" />
      <error statusCode="412" path="D:\Inetpub\vhosts\madecars.com\error_docs\precondition_failed.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="D:\Inetpub\vhosts\madecars.com\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="D:\Inetpub\vhosts\madecars.com\error_docs\unsupported_media_type.html" />
      <remove statusCode="500" />
      <error statusCode="500" path="D:\Inetpub\vhosts\madecars.com\error_docs\internal_server_error.html" />
      <remove statusCode="501" />
      <error statusCode="501" path="D:\Inetpub\vhosts\madecars.com\error_docs\not_implemented.html" />
      <remove statusCode="502" />
      <error statusCode="502" path="D:\Inetpub\vhosts\madecars.com\error_docs\bad_gateway.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="D:\Inetpub\vhosts\madecars.com\error_docs\maintenance.html" />
    </httpErrors>

    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="D:\Inetpub\vhosts\madecars.com\tmp" />
  </system.web>
</configuration>